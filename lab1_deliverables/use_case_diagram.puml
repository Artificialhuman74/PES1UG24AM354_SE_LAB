@startuml use_case_diagram
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F5F6F2
  BorderColor #17233B
  FontColor #17233B
  ArrowColor #17233B
}
skinparam actor {
  BorderColor #17233B
  FontColor #17233B
}
skinparam rectangle {
  BorderColor #17233B
  FontColor #17233B
}
skinparam ArrowFontColor #4B5568

actor "Student Team" as Team
actor "Panel Judge" as Judge
actor "Public Voter" as Voter

rectangle "Student Project Portfolio & Showcase System" {
  usecase "Create Showcase\nProfile" as UC1
  usecase "Validate Repository\nURL" as UC2
  usecase "Edit or Withdraw\nSubmission" as UC3
  usecase "Score Project\nvia Rubric" as UC4
  usecase "Calculate Aggregate\nScore" as UC5
  usecase "Cast Vote" as UC6
  usecase "Verify Voter\nIdentity" as UC7
  usecase "Flag Suspicious\nVoting Pattern" as UC8
  usecase "View Live\nLeaderboard" as UC9
}

Team --> UC1
Team --> UC3
Judge --> UC4
Voter --> UC6
Team --> UC9
Judge --> UC9
Voter --> UC9

UC1 ..> UC2 : <<include>>
UC4 ..> UC5 : <<include>>
UC6 ..> UC7 : <<include>>

UC3 ..> UC1 : <<extend>>
UC8 ..> UC6 : <<extend>>

@enduml
